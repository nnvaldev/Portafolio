---
import Layout from '../layouts/Layout.astro'
import Badge from '../components/Badge.astro'
import LinkedIn from '../components/icons/iconsHead/LinkedIn.astro'
import GitHub from '../components/icons/iconsHead/GitHub.astro'
import SocialPill from '../components/icons/SocialPill.astro'
import SocialPill2 from '../components/icons/SocialPill2.astro'
import Mail from '../components/icons/iconsHead/Mail.astro'
import Curriculum from '../components/icons/iconsHead/Curriculum.astro'
import Formation from '../components/Formation.astro'
import Css from '../components/icons/iconsSkills/Css.astro'
import React from '../components/icons/iconsSkills/React.astro'
import Tailwind from '../components/icons/iconsSkills/Tailwind.astro'
import Laravel from '../components/icons/iconsSkills/Laravel.astro'
import TypeScript from '../components/icons/iconsSkills/TypeScript.astro'
import DataBase from '../components/icons/iconsSkills/DataBase.astro'
import Python from '../components/icons/iconsSkills/Python.astro'
import Git from '../components/icons/iconsSkills/Git.astro'
import Docker from '../components/icons/iconsSkills/Docker.astro'
import Node from '../components/icons/iconsSkills/Node.astro'
import Php from '../components/icons/iconsSkills/Php.astro'
import JavaScript from '../components/icons/iconsSkills/JavaScript.astro'
import AstroIcon from '../components/icons/iconsSkills/AstroIcon.astro'
import Html from '../components/icons/iconsSkills/Html.astro'
import Aws from '../components/icons/iconsSkills/Aws.astro'
import FastApi from '../components/icons/iconsSkills/FastApi.astro'
import Flutter from '../components/icons/iconsSkills/Flutter.astro'
import Figma from '../components/icons/iconsSkills/Figma.astro'
import Skill from '../components/icons/iconsSkills/Skill.astro'
import Container from '../components/Container.astro'
import FormationIcon from '../components/icons/FormationIcon.astro'
import ProjectIcon from '../components/icons/ProjectIcon.astro'
import Project from '../components/Project.astro'
import ExperienceIcon from '../components/icons/ExperienceIcon.astro'
import Experience from '../components/Experience.astro'
import Stats from '../components/Stats.astro'
import profilePhoto from '../assets/profile photo.jpg'
import Vue from '../components/icons/iconsSkills/Vue.astro'
import NextJs from '../components/icons/iconsSkills/NextJs.astro'
import NestJs from '../components/icons/iconsSkills/NestJs.astro'
import Prisma from '../components/icons/iconsSkills/Prisma.astro'
import Redis from '../components/icons/iconsSkills/Redis.astro'
import Terraform from '../components/icons/iconsSkills/Terraform.astro'
import GitHubActions from '../components/icons/iconsSkills/GitHubActions.astro'
import Linux from '../components/icons/iconsSkills/Linux.astro'

const SKILL_GROUPS = [
	{
		title: 'Frontend',
		description: 'Interfaces web tipadas, accesibles y responsive.',
		skills: [
			{ name: 'TypeScript', icon: TypeScript },
			{ name: 'React', icon: React },
			{ name: 'Vue', icon: Vue },
			{ name: 'Next.js', icon: NextJs },
			{ name: 'Astro', icon: AstroIcon },
			{ name: 'Tailwind', icon: Tailwind },
			{ name: 'JavaScript', icon: JavaScript },
			{ name: 'HTML', icon: Html },
			{ name: 'CSS', icon: Css },
		],
	},
	{
		title: 'Backend y datos',
		description: 'APIs, colas, lógica de negocio y bases de datos.',
		skills: [
			{ name: 'Python', icon: Python },
			{ name: 'FastAPI', icon: FastApi },
			{ name: 'PHP', icon: Php },
			{ name: 'Laravel', icon: Laravel },
			{ name: 'Node.js', icon: Node },
			{ name: 'NestJS', icon: NestJs },
			{ name: 'PostgreSQL', icon: DataBase },
			{ name: 'Redis', icon: Redis },
			{ name: 'Prisma', icon: Prisma },
		],
	},
	{
		title: 'Cloud y DevOps',
		description: 'Infraestructura como código, contenedores y CI/CD.',
		skills: [
			{ name: 'AWS', icon: Aws },
			{ name: 'Docker', icon: Docker },
			{ name: 'Terraform', icon: Terraform },
			{ name: 'GitHub Actions', icon: GitHubActions },
			{ name: 'Linux', icon: Linux },
			{ name: 'Git', icon: Git },
		],
	},
	{
		title: 'Mobile y diseño',
		description: 'Apps nativas publicadas y sistemas de diseño.',
		skills: [
			{ name: 'Flutter', icon: Flutter },
			{ name: 'Figma', icon: Figma },
		],
	},
]
---

<Layout title='Alexander Castillo (nvaldev) — Fullstack & Cloud Engineer'
	description='Alexander Castillo (nvaldev), Fullstack & Cloud Engineer de La Paz, Bolivia, con 2+ años de experiencia. Python/FastAPI, Laravel, React, Vue, Flutter, AWS (Fargate, CDK), Docker, Terraform y CI/CD.'>

	<!-- Fondo decorativo -->
	<div class="fixed inset-0 -z-10 overflow-hidden">
		<div class="hero-grid"></div>
		<div class="blob blob-1"></div>
		<div class="blob blob-2"></div>
		<div class="blob blob-3"></div>
	</div>

	<main class="px-4 md:pl-20">
		<!-- Hero Section -->
		<Container id="home" class="min-h-screen flex flex-col justify-center py-20">
			<div class="hero-content" style="animation: fadeInUp 0.8s ease-out;">
				<!-- Foto con efecto glow -->
				<div class="flex justify-center mb-8">
					<div class="relative group">
						<div class="photo-ring absolute -inset-2 rounded-full opacity-70 group-hover:opacity-100 transition duration-500"></div>
						<img
							class="relative rounded-full w-32 h-32 sm:w-40 sm:h-40 md:w-48 md:h-48 object-cover ring-2 ring-cyan-500/40 shadow-2xl"
							src={profilePhoto.src}
							alt="Alexander Castillo — Fullstack & Cloud Engineer"
							width="192"
							height="192"
						/>
					</div>
				</div>

				<!-- Badge animado -->
				<div class="flex justify-center mb-6" style="animation: fadeInUp 0.8s ease-out 0.1s both;">
					<Badge>
						<span class="relative flex h-2 w-2 mr-2">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
						</span>
						<a href="https://www.linkedin.com/in/nvaldev/" target="_blank">
							Disponible para trabajar
						</a>
					</Badge>
				</div>

				<!-- Nombre con gradiente -->
				<h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-center mb-2" style="animation: fadeInUp 0.8s ease-out 0.2s both;">
					<span class="text-slate-100">Hola, soy </span>
					<span class="gradient-text">Alexander Castillo</span>
				</h1>
				<p class="text-center text-slate-500 font-mono mb-4" style="animation: fadeInUp 0.8s ease-out 0.25s both;">@nvaldev</p>

				<!-- Typing effect -->
				<div class="text-center mb-6" style="animation: fadeInUp 0.8s ease-out 0.3s both;">
					<h2 class="text-xl sm:text-2xl md:text-3xl text-slate-300">
						<span class="text-cyan-400 font-semibold" id="typing-text"></span>
						<span class="typing-cursor">|</span>
					</h2>
				</div>

				<!-- Descripción -->
				<p class="text-lg text-slate-400 text-center max-w-2xl mx-auto mb-6" style="animation: fadeInUp 0.8s ease-out 0.4s both;">
					Fullstack & Cloud Engineer de <span class="text-cyan-300">La Paz, Bolivia</span>, con
					<span class="text-cyan-300">2+ años de experiencia</span>. Construyo productos de punta a punta:
					backends en Python y PHP, interfaces en React y Vue, apps en Flutter, y la infraestructura
					que los sostiene en <span class="text-cyan-300">AWS</span> con Docker, Terraform y CI/CD.
				</p>

				<!-- Chips de tecnologías clave -->
				<div class="flex flex-wrap justify-center gap-2 mb-8" style="animation: fadeInUp 0.8s ease-out 0.45s both;">
					{["AWS · Fargate · CDK", "Python · FastAPI", "Laravel · PHP", "React · Vue · TypeScript", "Flutter", "Docker · Terraform · CI/CD"].map(tag => (
						<span class="text-xs sm:text-sm px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/25 text-cyan-300 font-medium">
							{tag}
						</span>
					))}
				</div>

				<!-- Botones de llamada a la acción -->
				<div class="flex flex-wrap justify-center gap-4 mb-8" style="animation: fadeInUp 0.8s ease-out 0.48s both;">
					<a href="#projects" class="cta-primary group">
						<span>Ver proyectos</span>
						<svg xmlns="http://www.w3.org/2000/svg" class="size-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path d="M13 6l6 6"></path>
						</svg>
					</a>
					<a href="#contact" class="cta-secondary shine-effect">
						Contáctame
					</a>
				</div>

				<!-- Social pills con animación escalonada -->
				<nav class="flex flex-wrap justify-center gap-4" style="animation: fadeInUp 0.8s ease-out 0.5s both;">
					<SocialPill href="/cv_es.pdf">
						<Curriculum class="size-4" />
						CV (ES)
					</SocialPill>
					<SocialPill href="/cv_en.pdf">
						<Curriculum class="size-4" />
						CV (EN)
					</SocialPill>
					<SocialPill href="https://www.linkedin.com/in/nvaldev/">
						<LinkedIn class="size-4" />
						LinkedIn
					</SocialPill>
					<SocialPill href="https://github.com/nnvaldev">
						<GitHub class="size-4" />
						GitHub
					</SocialPill>
					<SocialPill href="mailto:nnvaldev@gmail.com">
						<Mail class="size-4" />
						nnvaldev@gmail.com
					</SocialPill>
				</nav>

				<!-- Scroll indicator -->
				<div class="flex justify-center mt-16" style="animation: fadeInUp 0.8s ease-out 0.6s both;">
					<a href="#projects" class="scroll-indicator">
						<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
						</svg>
					</a>
				</div>
			</div>
		</Container>

		<!-- Stats + Marquee -->
		<div class="animate-on-scroll">
			<Stats />
		</div>

		<!-- Proyectos -->
		<Container id="projects" class="py-20">
			<div class="animate-on-scroll">
				<h2 class="text-3xl md:text-4xl text-slate-100 font-bold mb-2 flex gap-x-3 items-center">
					<ProjectIcon class="size-10 text-cyan-400" />
					<span>Proyectos</span>
				</h2>
				<p class="text-slate-400 mb-10">Algunos de mis trabajos recientes</p>
			</div>
			<div class="animate-on-scroll animate-delay-200">
				<Project />
			</div>
		</Container>

		<!-- Experiencia Laboral -->
		<Container id="experience" class="py-20">
			<div class="animate-on-scroll">
				<h2 class="text-3xl md:text-4xl text-slate-100 font-bold mb-2 flex gap-x-3 items-center">
					<ExperienceIcon class="size-10 text-cyan-400" />
					<span>Experiencia Laboral</span>
				</h2>
				<p class="text-slate-400 mb-10">Mi trayectoria profesional</p>
			</div>
			<div class="animate-on-scroll animate-delay-200">
				<Experience />
			</div>
		</Container>

		<!-- Habilidades -->
		<Container id="skills" class="py-20">
			<div class="animate-on-scroll">
				<h2 class="text-3xl md:text-4xl text-slate-100 font-bold mb-2 flex gap-x-3 items-center">
					<Skill class="size-10 text-cyan-400"/>
					<span>Habilidades</span>
				</h2>
				<p class="text-slate-400 mb-10">Tecnologías que uso en producción y en mis proyectos</p>
			</div>
			<div class="grid gap-8 md:grid-cols-2 animate-on-scroll animate-delay-200">
				{SKILL_GROUPS.map(group => (
					<div class="glass rounded-2xl p-6">
						<h3 class="text-lg font-semibold text-slate-100 mb-1">{group.title}</h3>
						<p class="text-sm text-slate-400 mb-5">{group.description}</p>
						<div class="flex flex-wrap gap-2.5">
							{group.skills.map(({ name, icon: Icon }) => (
								<SocialPill2 class="!px-3 !py-2 text-sm whitespace-nowrap">
									<Icon class="size-5 shrink-0" />
									{name}
								</SocialPill2>
							))}
						</div>
					</div>
				))}
			</div>
		</Container>

		<!-- Formación -->
		<Container id="formation" class="py-20">
			<div class="animate-on-scroll">
				<h2 class="text-3xl md:text-4xl text-slate-100 font-bold mb-2 flex gap-x-3 items-center">
					<FormationIcon class="size-10 text-cyan-400"/>
					<span>Formacion Academica</span>
				</h2>
				<p class="text-slate-400 mb-10">Mi trayectoria educativa</p>
			</div>
			<div class="animate-on-scroll animate-delay-200">
				<Formation />
			</div>
		</Container>

		<!-- Sobre mi -->
		<Container id="about" class="py-20">
			<div class="animate-on-scroll">
				<h2 class="text-3xl md:text-4xl text-slate-100 font-bold mb-2 flex gap-x-3 items-center">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class="size-10 text-cyan-400" stroke-width="2">
						<path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"></path>
						<path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
					</svg>
					<span>Sobre mi</span>
				</h2>
			</div>
			<div class="animate-on-scroll animate-delay-200 mt-8">
				<div class="glass rounded-2xl p-8 max-w-3xl">
					<p class="text-lg text-slate-300 leading-relaxed mb-4">
						Soy <span class="text-cyan-300 font-medium">Ingeniero de Software</span> con un perfil
						híbrido avanzado: combino el desarrollo <span class="text-cyan-300 font-medium">Fullstack</span>,
						la automatización de infraestructura (<span class="text-cyan-300 font-medium">DevOps / IaC</span>)
						y el diseño <span class="text-cyan-300 font-medium">UI/UX</span>.
					</p>
					<p class="text-lg text-slate-300 leading-relaxed mb-4">
						Llevo <span class="text-cyan-300 font-medium">2+ años trabajando en producción</span>:
						migré una plataforma a <span class="text-cyan-300 font-medium">AWS Fargate con CDK</span>,
						automaticé su CI/CD sin tiempo de inactividad, desarrollo su backend en
						<span class="text-cyan-300 font-medium">Python (FastAPI)</span>, su panel web en
						<span class="text-cyan-300 font-medium">React / TypeScript</span> y su app en
						<span class="text-cyan-300 font-medium">Flutter</span>, publicada en App Store y Google Play.
					</p>
					<p class="text-lg text-slate-300 leading-relaxed mb-4">
						En mis proyectos llevo esa misma forma de trabajar: tests de verdad, análisis estático,
						pipelines de CI, imágenes Docker de producción, infraestructura con
						<span class="text-cyan-300 font-medium">Terraform</span> y despliegues automáticos con rollback.
					</p>
					<p class="text-lg text-slate-300 leading-relaxed">
						Me gustan los problemas difíciles —concurrencia, multi-tenancy, zonas horarias, consistencia
						de datos— y alinear la ingeniería con lo que el negocio necesita. Estoy terminando la
						Licenciatura en Informática en la UMSA.
					</p>
				</div>
			</div>
		</Container>

		<!-- Contacto -->
		<Container id="contact" class="py-20 pb-32">
			<div class="animate-on-scroll">
				<h2 class="text-3xl md:text-4xl text-slate-100 font-bold mb-2 flex gap-x-3 items-center">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class="size-10 text-cyan-400" stroke-width="2">
						<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
						<path d="M3 7l9 6l9 -6"></path>
					</svg>
					<span>Contacto</span>
				</h2>
				<p class="text-slate-400 mb-10">Hablemos sobre tu proyecto</p>
			</div>
			<div class="animate-on-scroll animate-delay-200">
				<div class="glass rounded-2xl p-8 max-w-2xl">
					<p class="text-xl text-slate-300 mb-8">
						¿Tienes un proyecto en mente? ¡Me encantaria escucharte!
					</p>
					<div class="flex flex-wrap gap-4">
						<a href="mailto:nnvaldev@gmail.com" class="group inline-flex items-center gap-3 px-6 py-4 bg-gradient-to-r from-cyan-500/20 to-teal-500/20 border border-cyan-500/30 rounded-xl text-cyan-200 hover:border-cyan-400/50 hover:from-cyan-500/30 hover:to-teal-500/30 transition-all duration-300 shine-effect">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class="size-6 group-hover:scale-110 transition-transform" stroke-width="2">
								<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
								<path d="M3 7l9 6l9 -6"></path>
							</svg>
							<span class="font-medium">nnvaldev@gmail.com</span>
						</a>
						<a href="https://www.linkedin.com/in/nvaldev/" target="_blank" class="group inline-flex items-center gap-3 px-6 py-4 bg-gradient-to-r from-cyan-500/20 to-teal-500/20 border border-cyan-500/30 rounded-xl text-cyan-200 hover:border-cyan-400/50 hover:from-cyan-500/30 hover:to-teal-500/30 transition-all duration-300 shine-effect">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6 group-hover:scale-110 transition-transform">
								<path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"></path>
								<path d="M8 11l0 5"></path>
								<path d="M8 8l0 .01"></path>
								<path d="M12 16l0 -5"></path>
								<path d="M16 16v-3a2 2 0 0 0 -4 0"></path>
							</svg>
							<span class="font-medium">LinkedIn</span>
						</a>
					</div>
				</div>
			</div>
		</Container>
	</main>
</Layout>

<style>
	/* Fondo: grid sutil + blobs animados */
	.hero-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--card-border) 1px, transparent 1px),
			linear-gradient(90deg, var(--card-border) 1px, transparent 1px);
		background-size: 44px 44px;
		-webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 35%, #000 25%, transparent 80%);
		mask-image: radial-gradient(ellipse 70% 60% at 50% 35%, #000 25%, transparent 80%);
		opacity: 0.6;
	}

	.blob {
		position: absolute;
		border-radius: 9999px;
		filter: blur(80px);
		will-change: transform;
	}
	.blob-1 {
		top: 8%; left: -6%;
		width: 24rem; height: 24rem;
		background: var(--blob-1);
		animation: float-blob 14s ease-in-out infinite;
	}
	.blob-2 {
		bottom: 6%; right: -8%;
		width: 30rem; height: 30rem;
		background: var(--blob-2);
		animation: float-blob 18s ease-in-out infinite reverse;
	}
	.blob-3 {
		top: 55%; left: 38%;
		width: 20rem; height: 20rem;
		background: var(--blob-1);
		animation: float-blob 16s ease-in-out infinite;
	}

	@keyframes float-blob {
		0%, 100% { transform: translate(0, 0) scale(1); }
		33% { transform: translate(40px, -30px) scale(1.08); }
		66% { transform: translate(-30px, 25px) scale(0.95); }
	}

	/* Anillo giratorio detrás de la foto */
	.photo-ring {
		background: conic-gradient(from 0deg, var(--grad-a), var(--grad-b), var(--grad-a));
		filter: blur(14px);
		animation: spin-ring 6s linear infinite;
	}
	@keyframes spin-ring {
		to { transform: rotate(360deg); }
	}

	/* Botones CTA */
	.cta-primary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.75rem;
		border-radius: 0.85rem;
		font-weight: 600;
		color: #04201b;
		background: linear-gradient(90deg, var(--grad-a), var(--grad-b));
		box-shadow: 0 10px 30px var(--accent-soft);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.cta-primary:hover {
		transform: translateY(-3px);
		box-shadow: 0 16px 40px var(--accent-soft);
	}

	.cta-secondary {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.75rem;
		border-radius: 0.85rem;
		font-weight: 600;
		color: var(--accent);
		background: var(--accent-soft);
		border: 1px solid var(--card-border);
		transition: transform 0.25s ease, border-color 0.25s ease;
	}
	.cta-secondary:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.blob, .photo-ring { animation: none; }
	}

	.typing-cursor {
		animation: blink-caret 0.75s step-end infinite;
		color: var(--accent);
	}

	@keyframes blink-caret {
		from, to { opacity: 1; }
		50% { opacity: 0; }
	}

	.scroll-indicator {
		animation: float 2s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(10px); }
	}
</style>

<script>
	// Efecto typing
	const texts = [
		"Fullstack & Cloud Engineer",
		"Backend · FastAPI · Laravel · NestJS",
		"Frontend · React · Vue · Next.js",
		"Cloud & DevOps · AWS · Terraform",
		"Mobile Developer · Flutter"
	];

	let textIndex = 0;
	let charIndex = 0;
	let isDeleting = false;
	const typingElement = document.getElementById('typing-text');

	function type() {
		if (!typingElement) return;

		const currentText = texts[textIndex];

		if (isDeleting) {
			typingElement.textContent = currentText.substring(0, charIndex - 1);
			charIndex--;
		} else {
			typingElement.textContent = currentText.substring(0, charIndex + 1);
			charIndex++;
		}

		let typeSpeed = isDeleting ? 50 : 100;

		if (!isDeleting && charIndex === currentText.length) {
			typeSpeed = 2000;
			isDeleting = true;
		} else if (isDeleting && charIndex === 0) {
			isDeleting = false;
			textIndex = (textIndex + 1) % texts.length;
			typeSpeed = 500;
		}

		setTimeout(type, typeSpeed);
	}

	type();
</script>
