---
import ProjectItem from "./ProjectItem.astro";
import ProjectModal from "./ProjectModal.astro";

const PROJECT = [
    {
        name: "IDM E-Commerce — Marketplace Multi-empresa ERP",
        description: "Plataforma distribuida de alta disponibilidad para gestión de inventarios y ventas híbridas (B2C / B2B a crédito), con backend asíncrono y facturación electrónica SIAT.",
        longDescription: "Trabajo de Taller de Grado (UMSA). Plataforma distribuida de alta disponibilidad para la gestión de inventarios heterogéneos y flujos de venta híbridos: B2C minorista y B2B mayorista a crédito con control estricto de saldo de línea.",
        features: [
            "Backend concurrente asíncrono con FastAPI + SQLAlchemy Async sobre PostgreSQL 16, aplicando bloqueos pesimistas (SELECT ... FOR UPDATE) para garantizar consistencia absoluta en mutaciones críticas de stock.",
            "Micro-motor fiscal conforme al estándar SIAT (Bolivia): auto-emisión de facturas electrónicas en XML firmado (SHA-256) y generación de PDF con fpdf2, con flujos asíncronos en modo de contingencia ante caídas del servidor tributario.",
            "Logística distribuida multi-almacén interdepartamental (LP, CBBA, SCZ) con control de traspasos por estados transaccionales y escaneo nativo de códigos QR vía cámara web en el frontend.",
            "Panel administrativo y dashboards en React (TypeScript estricto) con control de acceso basado en roles (RBAC) granular en UI/API y analíticas de KPIs con Recharts."
        ],
        url: "#",
        github: "https://github.com/nnvaldev/idm-ecommerce",
        image: "/projectsCap/cap_catalog.png",
        images: ["/projectsCap/cap_catalog.png"],
        tags: ["Python", "FastAPI", "PostgreSQL", "SQLAlchemy", "React", "TypeScript", "Recharts", "Docker"]
    },
    {
        name: "La Paz Tour — Turismo Accesible en La Paz",
        description: "Guía web de La Paz con mapa interactivo, filtro de accesibilidad en silla de ruedas, rutas turísticas trazadas, conversor multi-moneda y reservas de experiencias. Trilingüe (ES/EN/PT).",
        longDescription: "Google Maps te dice dónde estás; La Paz Tour te dice si puedes entrar. Aplicación web pensada para el turista que llega a La Paz con poco tiempo y muchas dudas: cuánto vale su plata, qué lugares son realmente accesibles, qué ruta hacer y cómo reservarla. Todo resuelto en una sola página, sin instalar nada y sin depender de APIs de pago.",
        features: [
            "Mapa interactivo con Leaflet + OpenStreetMap (sin API key ni costo): 19 puntos georreferenciados con pines diferenciados por accesibilidad, popups con foto, precio de entrada, horario, contacto directo por WhatsApp y enlace de cómo llegar; incluye geolocalización del usuario.",
            "Filtro de accesibilidad como funcionalidad protagonista: un clic deja en el mapa y en la lista solo los sitios con rampas, baños adaptados o acceso a nivel, con datos validados junto a aliados como FEDEBOL.",
            "6 rutas turísticas dibujadas sobre el mapa como polilínea guía con paradas numeradas y ajuste automático de encuadre, cada una con duración, número de paradas y precio estimado.",
            "Conversor multi-moneda (8 divisas, tasa paralela) que no solo convierte: al elegir una moneda reprecia en vivo toda la página —entradas, rutas y experiencias— mediante eventos personalizados y persistencia en localStorage.",
            "Internacionalización propia ES / EN / PT sin librerías externas: diccionario y sistema de atributos data-i18n que traduce texto, aria-labels y contenido generado dinámicamente, más modo claro/oscuro persistente.",
            "Módulo de experiencias tipo marketplace con checkout demo: modal de reserva, cálculo de total por número de personas y generación de código de reserva, junto a un directorio de comercios locales para empujar la economía del barrio."
        ],
        url: "#",
        github: "https://github.com/nnvaldev/LaPazTour",
        image: "/projectsCap/cap_lpt_hero.png",
        images: ["/projectsCap/cap_lpt_hero.png", "/projectsCap/cap_lpt_mapa.png", "/projectsCap/cap_lpt_rutas.png", "/projectsCap/cap_lpt_experiencias.png"],
        tags: ["Astro", "JavaScript", "Tailwind", "Leaflet", "OpenStreetMap", "i18n", "Accesibilidad"]
    },
    {
        name: "AgendaPro — SaaS de Reservas y Citas",
        description: "Plataforma de agendamiento online para negocios de servicios: reservas en tiempo real, pago de seña y recordatorios automáticos, desde un panel multi-negocio. En desarrollo activo. 🚧",
        longDescription: "Proyecto en desarrollo activo. AgendaPro es un SaaS multi-tenant que permite a barberías, consultorios, canchas y cualquier negocio de servicios recibir reservas online 24/7 sin llamadas ni mensajes. El cliente reserva en segundos desde una página pública, el negocio gestiona su agenda y su staff desde un solo panel, y el pago de seña reduce las ausencias. Cada negocio trabaja aislado en su propio espacio, listo para escalar.",
        features: [
            "Reserva pública sin fricción: el cliente elige servicio, profesional y horario disponible en segundos, sin necesidad de crear una cuenta.",
            "Agenda y disponibilidad en tiempo real con WebSockets (Node.js): los cupos se bloquean al instante para evitar reservas dobles.",
            "Pago de seña/anticipo con pasarela integrada para reducir ausencias (no-shows), con confirmación automática y reembolsos.",
            "Recordatorios automáticos por email/WhatsApp y reprogramación o cancelación con un solo clic.",
            "Panel multi-negocio (multi-tenant) en Laravel: gestión de servicios, staff, horarios y métricas de ocupación e ingresos.",
            "Roles diferenciados (dueño / staff / cliente), interfaz responsive en Tailwind con modo claro/oscuro y despliegue en Docker con CI/CD."
        ],
        url: "#",
        github: "#",
        image: "/projectsCap/en-construccion.svg",
        images: [],
        tags: ["Laravel", "PHP", "Node.js", "Tailwind", "MySQL", "WebSockets", "Docker"],
        wip: true
    }
];
---

<ol class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {PROJECT.map((project, index) => {
        const openable = !!(project.longDescription || (project.features && project.features.length > 0));
        return (
            <li>
                <ProjectItem {...project} index={index} openable={openable} />
            </li>
        );
    })}
</ol>

{PROJECT.map((project, index) => (
    (project.longDescription || (project.features && project.features.length > 0)) &&
        <ProjectModal {...project} index={index} />
))}

<script>
    // Mover los modales al <body> para que escapen de ancestros con `transform`
    // (.animate-on-scroll) que rompen el posicionamiento `fixed`.
    document.querySelectorAll('.project-modal').forEach(m => document.body.appendChild(m));

    function openModal(id: string) {
        const modal = document.getElementById(id);
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeModal(modal: Element) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }

    // Abrir modal al hacer clic en una card (ignora clics en enlaces)
    document.querySelectorAll('[data-modal-open]').forEach(card => {
        card.addEventListener('click', (e) => {
            if ((e.target as HTMLElement).closest('a')) return;
            const id = card.getAttribute('data-modal-open');
            if (id) openModal(id);
        });
    });

    // Cerrar: botón de cerrar o backdrop
    document.querySelectorAll('.project-modal').forEach(modal => {
        modal.querySelectorAll('[data-modal-close]').forEach(btn => {
            btn.addEventListener('click', () => closeModal(modal));
        });
        // Cambiar imagen principal desde las miniaturas
        const main = modal.querySelector('[data-modal-main]') as HTMLImageElement | null;
        const zoom = modal.querySelector('[data-modal-zoom]') as HTMLAnchorElement | null;
        const thumbs = modal.querySelectorAll('[data-thumb]');
        thumbs.forEach(thumb => {
            thumb.addEventListener('click', () => {
                const src = (thumb as HTMLElement).getAttribute('data-thumb');
                if (!src || !main) return;
                main.src = src;
                if (zoom) zoom.href = src;
                thumbs.forEach(t => {
                    const active = t === thumb;
                    t.classList.toggle('border-cyan-400/70', active);
                    t.classList.toggle('border-cyan-500/20', !active);
                    t.classList.toggle('hover:border-cyan-400/60', !active);
                });
            });
        });
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('.project-modal:not(.hidden)').forEach(closeModal);
    });

    // Tilt 3D + glow que sigue el cursor (solo puntero fino, sin reduced-motion)
    const enableTilt = window.matchMedia('(pointer: fine)').matches
        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (enableTilt) {
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach(card => {
            card.addEventListener('pointermove', (e) => {
                const r = card.getBoundingClientRect();
                const px = (e.clientX - r.left) / r.width;
                const py = (e.clientY - r.top) / r.height;
                const rotX = (py - 0.5) * -7;
                const rotY = (px - 0.5) * 7;
                card.style.transform = `perspective(900px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-6px)`;
                card.style.setProperty('--gx', `${px * 100}%`);
                card.style.setProperty('--gy', `${py * 100}%`);
            });
            card.addEventListener('pointerleave', () => {
                card.style.transform = '';
            });
        });
    }
</script>
