---
import ProjectItem from "./ProjectItem.astro";
import ProjectModal from "./ProjectModal.astro";

const PROJECT = [
    {
        name: "AgendaPro — SaaS de Reservas Online",
        description: "SaaS multi-negocio para barberías, consultorios y canchas: página pública de reservas sin registro, panel con agenda y horarios, correos en cola, CI/CD e infraestructura como código. 92 tests sobre PostgreSQL.",
        longDescription: "Producto completo de punta a punta: el negocio configura servicios, equipo y horarios; sus clientes reservan desde un link público en segundos, sin crear cuenta; y el dueño gestiona todo desde un panel. Pensado para Bolivia (zona horaria de La Paz, precios en bolivianos, contacto por WhatsApp) y construido con prácticas de producción: aislamiento entre negocios, cero reservas dobles garantizado por la base de datos, pipeline de calidad y despliegue automático con rollback.",
        features: [
            "Cero reservas dobles garantizado por PostgreSQL: restricción EXCLUDE con tstzrange sobre el profesional, que rechaza reservas que se cruzan aunque lleguen en paralelo; el servicio captura la violación y asigna al siguiente profesional libre.",
            "Multi-tenant en una sola base: global scope por negocio aplicado antes del route model binding, así pedir un recurso de otro negocio devuelve 404 (cubierto por tests de aislamiento).",
            "Motor de disponibilidad por zona horaria: bloques semanales con pausa de almuerzo, intervalo configurable, anticipación mínima, ventana de reserva y bloqueos de agenda; todo guardado en UTC y mostrado en hora de La Paz.",
            "Panel en Vue 3 + TypeScript (Inertia, rutas tipadas con Wayfinder): agenda diaria con contacto por WhatsApp y estados, editor de horario semanal, servicios, equipo e indicadores del negocio.",
            "Correos en cola con Redis (confirmación con .ics, recordatorio 24 h antes vía Scheduler, avisos de cancelación), encolados con afterCommit y sin romper la reserva si falla la cola.",
            "DevOps: imagen de producción con FrankenPHP (HTTPS automático, Alpine, sin root), GitHub Actions (Pint, PHPStan nivel 7, lint, tipos, tests, Terraform), servidor en Oracle Cloud con Terraform y tests sin cuenta, y deploy automático con healthchecks, rollback y backups diarios."
        ],
        url: "#",
        github: "https://github.com/nnvaldev/agendapro",
        image: "/projectsCap/cap_ap_portada.png",
        images: ["/projectsCap/cap_ap_portada.png", "/projectsCap/cap_ap_reserva.png", "/projectsCap/cap_ap_panel.png", "/projectsCap/cap_ap_horario.png"],
        tags: ["Laravel 13", "Vue 3", "TypeScript", "PostgreSQL", "Redis", "Docker", "Terraform", "GitHub Actions"]
    },
    {
        name: "IDM E-Commerce — Marketplace Multi-empresa ERP",
        description: "Marketplace multi-empresa y ERP para una importadora de repuestos: ventas B2C y B2B a crédito, inventario multi-almacén con bloqueos pesimistas, POS de mostrador y flujo de facturación SIAT.",
        longDescription: "Trabajo de Taller de Grado (UMSA). Plataforma para la gestión de inventarios heterogéneos (repuestos, lubricantes, vehículos) y flujos de venta híbridos: B2C minorista, B2B mayorista a crédito con control estricto de saldo de línea y POS en sucursal, sobre tres almacenes en La Paz, Cochabamba y Santa Cruz. Cualquier empresa puede registrarse como vendedora y operar aislada de las demás.",
        features: [
            "Backend asíncrono con FastAPI + SQLAlchemy Async sobre PostgreSQL 16, con bloqueos pesimistas (SELECT ... FOR UPDATE) en cada mutación de stock, restricción única producto-almacén con reintento y bitácora de movimientos.",
            "Ciclo reservar → consumir: el carrito y el checkout reservan stock, la aprobación B2B lo consume y el rechazo lo libera; el crédito se valida al confirmar y otra vez al aprobar, con montos en Decimal y precio congelado en la orden.",
            "Flujo de facturación SIAT (Bolivia, cliente simulado): la factura se guarda antes de enviarse, timeout de 5 s, modo contingencia con reintento por lotes de 50, emisión idempotente después de confirmar la venta y PDF con fpdf2.",
            "Logística distribuida multi-almacén interdepartamental (LP, CBBA, SCZ) con control de traspasos por estados transaccionales y escaneo nativo de códigos QR vía cámara web en el frontend.",
            "Panel administrativo y dashboards en React (TypeScript estricto) con control de acceso basado en roles (RBAC) granular en UI/API y analíticas de KPIs con Recharts."
        ],
        url: "#",
        github: "https://github.com/nnvaldev/IDM-Ecommerce-System",
        image: "/projectsCap/cap_catalog.png",
        images: ["/projectsCap/cap_catalog.png", "/projectsCap/cap_idm_reportes.png", "/projectsCap/cap_idm_pos.png", "/projectsCap/cap_idm_inventario.png", "/projectsCap/cap_idm_traspaso-qr.png", "/projectsCap/cap_idm_facturas.png"],
        tags: ["Python", "FastAPI", "PostgreSQL", "SQLAlchemy", "React", "TypeScript", "Recharts", "Docker"]
    },
    {
        name: "La Paz Tour — Turismo Accesible en La Paz",
        description: "Guía web de La Paz con mapa interactivo, filtro de accesibilidad en silla de ruedas, rutas turísticas trazadas, conversor multi-moneda y reservas de experiencias. Trilingüe (ES/EN/PT).",
        longDescription: "Google Maps te dice dónde estás; La Paz Tour te dice si puedes entrar. Aplicación web pensada para el turista que llega a La Paz con poco tiempo y muchas dudas: cuánto vale su plata, qué lugares son realmente accesibles, qué ruta hacer y cómo reservarla. Todo resuelto en una sola página, sin instalar nada y sin depender de APIs de pago.",
        features: [
            "Mapa interactivo con Leaflet + OpenStreetMap (sin API key ni costo): 15 atractivos (más 4 paradas que aparecen al elegir una ruta) con pines diferenciados por accesibilidad, popups con foto, precio de entrada, horario, contacto directo por WhatsApp y enlace de cómo llegar; incluye geolocalización del usuario.",
            "Filtro de accesibilidad como funcionalidad protagonista: un clic deja en el mapa y en la lista solo los sitios con rampas, baños adaptados o acceso a nivel.",
            "6 rutas turísticas dibujadas sobre el mapa como polilínea guía con paradas numeradas y ajuste automático de encuadre, cada una con duración, número de paradas y precio estimado.",
            "Conversor multi-moneda (8 divisas, tasa paralela) que no solo convierte: al elegir una moneda reprecia en vivo toda la página —entradas, rutas y experiencias— mediante eventos personalizados y persistencia en localStorage.",
            "Internacionalización propia ES / EN / PT sin librerías externas: diccionario de 99 claves por idioma y atributos data-i18n que traducen la interfaz, aria-labels y los popups del mapa, más modo claro/oscuro persistente.",
            "Módulo de experiencias tipo marketplace con checkout demo: modal de reserva, cálculo de total por número de personas y generación de código de reserva, junto a un directorio de comercios locales para empujar la economía del barrio."
        ],
        url: "https://la-paz-tour.vercel.app/",
        github: "https://github.com/nnvaldev/LaPazTour",
        image: "/projectsCap/cap_lpt_hero.png",
        images: ["/projectsCap/cap_lpt_hero.png", "/projectsCap/cap_lpt_mapa.png", "/projectsCap/cap_lpt_rutas.png", "/projectsCap/cap_lpt_experiencias.png"],
        tags: ["Astro", "JavaScript", "Tailwind", "Leaflet", "OpenStreetMap", "i18n", "Accesibilidad"]
    },
    {
        name: "JobBoard Pro — Portal de Empleos Full-Stack",
        description: "Portal de empleos de doble cara (candidato / empresa) construido como monorepo: API NestJS + Prisma sobre PostgreSQL y frontend Next.js 15. Autenticación JWT con refresh automático, roles y gestión completa del ciclo de postulación.",
        longDescription: "Portal de empleos que resuelve las dos caras del proceso de contratación en un solo producto: la empresa publica vacantes, controla borradores y revisa postulantes desde su panel; el candidato busca con filtros, se postula con carta de presentación y sigue el estado de cada aplicación. Construido como monorepo pnpm con backend y frontend desacoplados, compartiendo un paquete de tipos y enums para que ambos lados hablen exactamente el mismo lenguaje.",
        features: [
            "Monorepo con pnpm workspaces: apps/web (Next.js 15, App Router y Server Components), apps/api (NestJS 11) y packages/shared con los enums y etiquetas de dominio tipados, eliminando la duplicación de contratos entre backend y frontend.",
            "Autenticación JWT de doble token (access de 15 min + refresh de 7 días) con hashing bcrypt, y un cliente HTTP propio que intercepta los 401, renueva el token y reintenta la petición original de forma transparente para el usuario; middleware de Next.js que protege las rutas del panel antes de renderizar.",
            "Control de acceso por roles CANDIDATE / EMPLOYER mediante guards y decoradores personalizados, reforzado con verificación de propiedad a nivel de servicio: una empresa nunca puede leer ni modificar ofertas o postulantes que no pertenezcan a su compañía.",
            "Buscador público con filtros combinables (texto sobre título, descripción y nombre de empresa; ubicación, tipo de contrato, seniority y modalidad remota) y paginación resuelta en servidor con Prisma, sobre un esquema indexado por estado, ubicación, tipo y seniority.",
            "Ciclo de vida completo de la vacante: la empresa la crea como borrador o publicada, el candidato se postula con carta de presentación —con restricción única compuesta que impide postulaciones duplicadas— y la empresa mueve el estado por pendiente, en revisión, aceptada o rechazada.",
            "API documentada con Swagger y validación global vía class-validator en modo estricto (whitelist + rechazo de campos no declarados), PostgreSQL 16 orquestado con Docker Compose y seed de datos con cuentas demo para levantar el proyecto de cero en minutos."
        ],
        url: "#",
        github: "https://github.com/nnvaldev/JobBoard",
        image: "/projectsCap/cap_jb_home.png",
        images: ["/projectsCap/cap_jb_home.png", "/projectsCap/cap_jb_ofertas.png", "/projectsCap/cap_jb_empresa.png", "/projectsCap/cap_jb_nueva.png"],
        tags: ["Next.js", "NestJS", "TypeScript", "PostgreSQL", "Prisma", "JWT", "Docker", "Tailwind"]
    }
];
---

<ol class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {PROJECT.map((project, index) => {
        const openable = !!(project.longDescription || (project.features && project.features.length > 0));
        return (
            <li>
                <ProjectItem {...project} index={index} openable={openable} />
            </li>
        );
    })}
</ol>

{PROJECT.map((project, index) => (
    (project.longDescription || (project.features && project.features.length > 0)) &&
        <ProjectModal {...project} index={index} />
))}

<script>
    // Mover los modales al <body> para que escapen de ancestros con `transform`
    // (.animate-on-scroll) que rompen el posicionamiento `fixed`.
    document.querySelectorAll('.project-modal').forEach(m => document.body.appendChild(m));

    function openModal(id: string) {
        const modal = document.getElementById(id);
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeModal(modal: Element) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }

    // Abrir modal al hacer clic en una card (ignora clics en enlaces)
    document.querySelectorAll('[data-modal-open]').forEach(card => {
        card.addEventListener('click', (e) => {
            if ((e.target as HTMLElement).closest('a')) return;
            const id = card.getAttribute('data-modal-open');
            if (id) openModal(id);
        });
    });

    // Cerrar: botón de cerrar o backdrop
    document.querySelectorAll('.project-modal').forEach(modal => {
        modal.querySelectorAll('[data-modal-close]').forEach(btn => {
            btn.addEventListener('click', () => closeModal(modal));
        });
        // Cambiar imagen principal desde las miniaturas
        const main = modal.querySelector('[data-modal-main]') as HTMLImageElement | null;
        const zoom = modal.querySelector('[data-modal-zoom]') as HTMLAnchorElement | null;
        const thumbs = modal.querySelectorAll('[data-thumb]');
        thumbs.forEach(thumb => {
            thumb.addEventListener('click', () => {
                const src = (thumb as HTMLElement).getAttribute('data-thumb');
                if (!src || !main) return;
                main.src = src;
                if (zoom) zoom.href = src;
                thumbs.forEach(t => {
                    const active = t === thumb;
                    t.classList.toggle('border-cyan-400/70', active);
                    t.classList.toggle('border-cyan-500/20', !active);
                    t.classList.toggle('hover:border-cyan-400/60', !active);
                });
            });
        });
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('.project-modal:not(.hidden)').forEach(closeModal);
    });

    // Tilt 3D + glow que sigue el cursor (solo puntero fino, sin reduced-motion)
    const enableTilt = window.matchMedia('(pointer: fine)').matches
        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (enableTilt) {
        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach(card => {
            card.addEventListener('pointermove', (e) => {
                const r = card.getBoundingClientRect();
                const px = (e.clientX - r.left) / r.width;
                const py = (e.clientY - r.top) / r.height;
                const rotX = (py - 0.5) * -7;
                const rotY = (px - 0.5) * 7;
                card.style.transform = `perspective(900px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-6px)`;
                card.style.setProperty('--gx', `${px * 100}%`);
                card.style.setProperty('--gy', `${py * 100}%`);
            });
            card.addEventListener('pointerleave', () => {
                card.style.transform = '';
            });
        });
    }
</script>
