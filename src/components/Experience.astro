---
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE = [
    {
        date: "2025 - Presente",
        title: "Fullstack & Cloud Engineer",
        company: "Trabajito.bo",
        description: "Lidero la evolución tecnológica y la infraestructura cloud de la plataforma: backend, panel web, app móvil e infraestructura en AWS.",
        highlights: [
            "Diseñé e implementé la migración a AWS Fargate con AWS CDK (IaC): ECS con autoescalado, ALB, WAF, RDS, ElastiCache y Secrets Manager, con entornos aislados de Staging y Producción.",
            "Integré CI/CD entre GitHub y AWS CodeBuild con despliegues sin tiempo de inactividad (Zero-Downtime).",
            "Desarrollo y optimizo el backend en Python (FastAPI, SQLAlchemy async, PostgreSQL, Redis) con tiempo real por WebSockets.",
            "Construyo el panel web en React + TypeScript (Feature-Sliced Design, Zustand, tests con Vitest y Playwright) desplegado en Vercel.",
            "Desarrollo la app móvil en Flutter (arquitectura limpia, push con Firebase) y gestiono su publicación en App Store y Google Play.",
            "Configuré observabilidad y alarmas en CloudWatch (CPU, memoria, base de datos) que redujeron los incidentes en producción, y creé el sistema de componentes en Figma con Dark Mode nativo.",
        ],
        technologies: ["AWS Fargate", "AWS CDK", "RDS", "ElastiCache", "WAF", "CodeBuild", "CloudWatch", "Python", "FastAPI", "PostgreSQL", "Redis", "React", "TypeScript", "Flutter", "Firebase", "Docker", "Vercel", "Figma"],
        current: true
    }
]
---

<div class="space-y-6">
    {EXPERIENCE.map((exp, index) => (
        <div class="animate-on-scroll" style={`transition-delay: ${index * 0.1}s`}>
            <ExperienceItem {...exp} />
        </div>
    ))}
</div>
