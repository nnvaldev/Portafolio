---
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE = [
    {
        date: "2025 - Presente",
        title: "Fullstack & Cloud Engineer",
        company: "Trabajito.bo",
        description: "Lidero la evolución tecnológica y la infraestructura cloud de la plataforma. Diseñé e implementé la migración estratégica a AWS Fargate con AWS CDK (IaC), automatizando entornos aislados de Staging y Producción, e integré flujos CI/CD entre GitHub y AWS CodeBuild logrando despliegues sin tiempo de inactividad (Zero-Downtime). Desarrollé y optimicé servicios backend robustos en Python (FastAPI) consumidos por una app móvil de alta fidelidad en Flutter (arquitectura limpia); lideré el despliegue del frontend en Vercel y gestioné la distribución nativa en App Store y Google Play. Configuré observabilidad y alarmas en CloudWatch (CPU, memoria, DB) que redujeron los incidentes en producción, y creé el sistema de componentes en Figma implementando un Dark Mode nativo.",
        technologies: ["AWS Fargate", "AWS CDK", "CodeBuild", "CloudWatch", "Python", "FastAPI", "Flutter", "Vercel", "Docker", "Figma"],
        current: true
    }
]
---

<div class="space-y-6">
    {EXPERIENCE.map((exp, index) => (
        <div class="animate-on-scroll" style={`transition-delay: ${index * 0.1}s`}>
            <ExperienceItem {...exp} />
        </div>
    ))}
</div>
